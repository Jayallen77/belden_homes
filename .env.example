NODE_ENV=production
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=https://www.beldenhomesinc.com
# IP-authenticated Google Workspace relay (no username/password auth).
SMTP_RELAY=true
SMTP_HOST=smtp-relay.gmail.com
SMTP_PORT=587
SMTP_FROM=inquiries@beldenhomesinc.com
# Use the VPS's valid public hostname for EHLO; Google rejects loopback EHLO names.
SMTP_HELO_NAME=srv1356130.hstgr.cloud
# Backward-compatible authenticated SMTP mode: set SMTP_RELAY=false and
# provide SMTP_USER/SMTP_PASS. SMTP_FROM then defaults to SMTP_USER.
SMTP_USER=
SMTP_PASS=
# Set true only behind the included local reverse proxy, which overwrites X-Real-IP.
TRUST_PROXY=true
INQUIRY_JOURNAL_DIR=/var/lib/belden/inquiries
