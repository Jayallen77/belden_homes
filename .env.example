NODE_ENV=production
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=https://www.beldenhomesinc.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=inquiries@beldenhomesinc.com
# Gmail app password, configured only in the VPS secret environment file.
SMTP_PASS=
# Set true only behind the included local reverse proxy, which overwrites X-Real-IP.
TRUST_PROXY=true
INQUIRY_JOURNAL_DIR=/var/lib/belden/inquiries
